ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://factory:factory@localhost:5432/factory
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
DEFAULT_LEASE_TTL_SECONDS=900
RUN_HEARTBEAT_TIMEOUT_SECONDS=120
MAX_RUN_MINUTES=45
MAX_RUN_TOKENS=120000
ENABLED_HARNESSES=codex
RUNNER_POLL_INTERVAL_SECONDS=5
DEFAULT_BASE_BRANCH=main
PUSH_BRANCHES=false
SANDBOX_WORKSPACE_ROOT=.sandbox/workspaces
ARTIFACTS_ROOT=artifacts
QUEUE_NAME=factory:ready
DEAD_LETTER_QUEUE_NAME=factory:dlq
MANAGER_DISPATCH_POLL_INTERVAL_SECONDS=15
MANAGER_DISPATCH_BATCH_SIZE=25
